rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------- Shared Primitives ----------
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidTopicIdStr(topicId) {
      return topicId is string && topicId.matches('^([1-9]|1[0-1])$');
    }

    function isBootstrappedAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'ohhboyss338@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin()
        || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidRole(role) {
      return role in ['student', 'teacher'];
    }

    function isValidMode(mode) {
      return mode in ['classic', 'byte_blaster', 'circuit_grid', 'tower_climb', 'heart_quest', 'pixel_boss'];
    }

    function isValidQuestionFilter(filter) {
      return filter in ['mcq', 'fill_blank', 'mixed'];
    }

    // SHA-256 digest of the teacher registration access code (never stored in plaintext)
    function expectedTeacherCodeDigest() {
      return '78ebd19b11ac5f31df75eda86b70aa1feb9a7b361e020ce4f183697faa348321';
    }

    // ---------- Entity Validation Blueprints ----------
    function isValidUser(data, userId) {
      return data.keys().hasAll(['uid', 'name', 'email', 'role', 'className', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'name', 'email', 'role', 'className', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 254
        && isValidRole(data.role)
        && data.className is string && data.className.size() >= 1 && data.className.size() <= 64
        && data.createdAt is string && data.createdAt.size() >= 10 && data.createdAt.size() <= 40
        && data.updatedAt is timestamp;
    }

    function isValidAdminRecord(data, userId) {
      return data.keys().hasAll(['uid', 'codeDigest', 'createdAt'])
        && data.keys().hasOnly(['uid', 'codeDigest', 'createdAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.codeDigest is string && data.codeDigest.size() == 64
        && data.createdAt is timestamp;
    }

    function isValidNotesProgress(data, userId, topicIdInt) {
      return data.keys().hasAll(['uid', 'topicId', 'readNodeIds', 'completed', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'topicId', 'readNodeIds', 'completed', 'completedAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.topicId is int && data.topicId == topicIdInt && data.topicId >= 1 && data.topicId <= 11
        && data.readNodeIds is list && data.readNodeIds.size() <= 30
        && (data.readNodeIds.size() == 0 || data.readNodeIds[0] is string)
        && data.completed is bool
        && (!('completedAt' in data) || (data.completedAt is string && data.completedAt.size() <= 40))
        && data.updatedAt is timestamp;
    }

    function isValidAssignment(data, userId, topicIdInt) {
      return data.keys().hasAll(['uid', 'topicId', 'questionIds', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'topicId', 'questionIds', 'updatedAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.topicId is int && data.topicId == topicIdInt && data.topicId >= 1 && data.topicId <= 11
        && data.questionIds is list && data.questionIds.size() <= 500
        && (data.questionIds.size() == 0 || data.questionIds[0] is string)
        && data.updatedAt is timestamp;
    }

    function isValidQuestionUsage(data, topicIdInt) {
      return data.keys().hasAll(['topicId', 'usedIds', 'updatedAt'])
        && data.keys().hasOnly(['topicId', 'usedIds', 'updatedAt'])
        && data.topicId is int && data.topicId == topicIdInt && data.topicId >= 1 && data.topicId <= 11
        && data.usedIds is list && data.usedIds.size() <= 2000
        && (data.usedIds.size() == 0 || data.usedIds[0] is string)
        && data.updatedAt is timestamp;
    }

    function isValidRanking(data, attemptId) {
      return data.keys().hasAll([
          'attemptId', 'userId', 'studentName', 'className', 'topicId',
          'topicTitle', 'mode', 'questionFilter', 'score', 'totalQuestions',
          'percentage', 'timeTakenSeconds', 'completedAt', 'isPublicRanking', 'createdAt'
        ])
        && data.keys().hasOnly([
          'attemptId', 'userId', 'studentName', 'className', 'topicId',
          'topicTitle', 'mode', 'questionFilter', 'score', 'totalQuestions',
          'percentage', 'timeTakenSeconds', 'completedAt', 'isPublicRanking', 'createdAt'
        ])
        && data.attemptId is string && data.attemptId == attemptId && isValidId(data.attemptId)
        && data.userId is string && isValidId(data.userId)
        && data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 100
        && data.className is string && data.className.size() >= 1 && data.className.size() <= 64
        && data.topicId is int && data.topicId >= 1 && data.topicId <= 11
        && data.topicTitle is string && data.topicTitle.size() >= 1 && data.topicTitle.size() <= 160
        && isValidMode(data.mode)
        && isValidQuestionFilter(data.questionFilter)
        && data.totalQuestions is int && data.totalQuestions >= 1 && data.totalQuestions <= 55
        && data.score is int && data.score >= 0 && data.score <= data.totalQuestions
        && data.percentage is int && data.percentage >= 0 && data.percentage <= 100
        && data.timeTakenSeconds is int && data.timeTakenSeconds >= 0 && data.timeTakenSeconds <= 7200
        && data.completedAt is string && data.completedAt.size() >= 10 && data.completedAt.size() <= 40
        && data.isPublicRanking is bool && data.isPublicRanking == true
        && data.createdAt is timestamp;
    }

    function isValidQuestion(data, questionId) {
      return data.keys().hasAll([
          'id', 'topicId', 'type', 'subtopicCode', 'prompt',
          'options', 'correctAnswer', 'acceptedAnswers', 'explanation', 'status', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'topicId', 'type', 'subtopicCode', 'prompt',
          'options', 'correctAnswer', 'acceptedAnswers', 'explanation', 'status', 'updatedAt'
        ])
        && data.id is string && data.id == questionId && isValidId(data.id)
        && data.topicId is int && data.topicId >= 1 && data.topicId <= 11
        && data.type in ['mcq', 'fill_blank']
        && data.subtopicCode is string && data.subtopicCode.size() >= 1 && data.subtopicCode.size() <= 24
        && data.prompt is string && data.prompt.size() >= 1 && data.prompt.size() <= 1000
        && data.options is list && data.options.size() <= 6
        && (data.options.size() == 0 || data.options[0] is string)
        && data.correctAnswer is string && data.correctAnswer.size() >= 1 && data.correctAnswer.size() <= 300
        && data.acceptedAnswers is list && data.acceptedAnswers.size() <= 20
        && (data.acceptedAnswers.size() == 0 || data.acceptedAnswers[0] is string)
        && data.explanation is string && data.explanation.size() >= 1 && data.explanation.size() <= 1000
        && data.status in ['active', 'deleted']
        && data.updatedAt is timestamp;
    }

    function isValidSettings(data) {
      return data.keys().hasAll(['enabledTopics', 'requireNotesBeforeQuiz', 'enabledGames', 'updatedAt'])
        && data.keys().hasOnly(['enabledTopics', 'requireNotesBeforeQuiz', 'enabledGames', 'updatedAt'])
        && data.enabledTopics is list && data.enabledTopics.size() <= 11
        && (data.enabledTopics.size() == 0 || data.enabledTopics[0] is int)
        && data.requireNotesBeforeQuiz is bool
        && data.enabledGames is list && data.enabledGames.size() <= 6
        && (data.enabledGames.size() == 0 || data.enabledGames[0] is string)
        && data.updatedAt is timestamp;
    }

    // ---------- Connection Check ----------
    match /test/connection {
      allow get: if isSignedIn();
      allow list, write: if false;
    }

    // ---------- Admin Privilege Markers ----------
    match /admins/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if false;

      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidAdminRecord(incoming(), userId)
        && incoming().createdAt == request.time
        && (isBootstrappedAdmin() || incoming().codeDigest == expectedTeacherCodeDigest());

      allow update: if false;
      allow delete: if isValidId(userId) && isAdmin();
    }

    // ---------- Users (PII Isolated) ----------
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && (existing().uid == request.auth.uid || isAdmin());

      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUser(incoming(), userId)
        && incoming().updatedAt == request.time
        && (
          incoming().role == 'student'
          || (
            incoming().role == 'teacher'
            && (isAdmin() || existsAfter(/databases/$(database)/documents/admins/$(userId)))
          )
        );

      allow update: if isValidId(userId)
        && isValidUser(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            isOwner(userId)
            && incoming().role == existing().role
            && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'className', 'updatedAt'])
          )
        );

      allow delete: if isValidId(userId) && isAdmin();

      // Mind Map Reading Progress Subcollection
      match /notesProgress/{topicId} {
        allow get: if isValidId(userId) && isValidTopicIdStr(topicId) && (isOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && (isOwner(userId) || isAdmin());

        allow create: if isValidId(userId)
          && isValidTopicIdStr(topicId)
          && (isOwner(userId) || isAdmin())
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidNotesProgress(incoming(), userId, int(topicId))
          && incoming().updatedAt == request.time;

        allow update: if isValidId(userId)
          && isValidTopicIdStr(topicId)
          && (isOwner(userId) || isAdmin())
          && isValidNotesProgress(incoming(), userId, int(topicId))
          && incoming().uid == existing().uid
          && incoming().topicId == existing().topicId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['readNodeIds', 'completed', 'completedAt', 'updatedAt']);

        allow delete: if isValidId(userId) && isValidTopicIdStr(topicId) && isAdmin();
      }

      // Per-student Assigned Question History Subcollection
      match /assignments/{topicId} {
        allow get: if isValidId(userId) && isValidTopicIdStr(topicId) && (isOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && (isOwner(userId) || isAdmin());

        allow create: if isValidId(userId)
          && isValidTopicIdStr(topicId)
          && (isOwner(userId) || isAdmin())
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidAssignment(incoming(), userId, int(topicId))
          && incoming().updatedAt == request.time;

        allow update: if isValidId(userId)
          && isValidTopicIdStr(topicId)
          && (isOwner(userId) || isAdmin())
          && isValidAssignment(incoming(), userId, int(topicId))
          && incoming().uid == existing().uid
          && incoming().topicId == existing().topicId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['questionIds', 'updatedAt']);

        allow delete: if isValidId(userId) && isValidTopicIdStr(topicId) && isAdmin();
      }
    }

    // ---------- Non-PII Global Question Assignment Pool ----------
    match /questionUsage/{topicId} {
      allow get: if isValidTopicIdStr(topicId) && isSignedIn();
      allow list: if false;

      allow create: if isValidTopicIdStr(topicId)
        && isSignedIn()
        && isValidQuestionUsage(incoming(), int(topicId))
        && incoming().updatedAt == request.time;

      allow update: if isValidTopicIdStr(topicId)
        && isSignedIn()
        && isValidQuestionUsage(incoming(), int(topicId))
        && incoming().topicId == existing().topicId
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['usedIds', 'updatedAt']);

      allow delete: if isValidTopicIdStr(topicId) && isAdmin();
    }

    // ---------- Topic Rankings / Attempts (No PII) ----------
    match /rankings/{attemptId} {
      allow get: if isValidId(attemptId) && isSignedIn();
      allow list: if isSignedIn() && existing().isPublicRanking == true;

      allow create: if isValidId(attemptId)
        && isSignedIn()
        && isValidRanking(incoming(), attemptId)
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time;

      allow update: if isValidId(attemptId)
        && isAdmin()
        && isValidRanking(incoming(), attemptId)
        && incoming().attemptId == existing().attemptId
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt;

      allow delete: if isValidId(attemptId) && isAdmin();
    }

    // ---------- Teacher-Managed Custom / Edited Questions ----------
    match /questions/{questionId} {
      allow get: if isValidId(questionId) && isSignedIn();
      allow list: if isSignedIn() && existing().topicId >= 1 && existing().topicId <= 11;

      allow create: if isValidId(questionId)
        && isAdmin()
        && isValidQuestion(incoming(), questionId)
        && incoming().updatedAt == request.time;

      allow update: if isValidId(questionId)
        && isAdmin()
        && isValidQuestion(incoming(), questionId)
        && incoming().id == existing().id
        && incoming().updatedAt == request.time;

      allow delete: if isValidId(questionId) && isAdmin();
    }

    // ---------- Global Classroom Settings ----------
    match /settings/app {
      allow get: if isSignedIn();
      allow list: if false;

      allow create: if isAdmin()
        && isValidSettings(incoming())
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidSettings(incoming())
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'enabledTopics', 'requireNotesBeforeQuiz', 'enabledGames', 'updatedAt'
        ]);

      allow delete: if false;
    }
  }
}
